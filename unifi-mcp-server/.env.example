# UniFi Controller Configuration
# Copy this file to .env and fill in your values

# Controller URL (required)
# Self-hosted: https://your-ip:8443
# UDM Pro/SE/UCG: https://your-ip:443
UNIFI_CONTROLLER_URL=https://192.168.1.1:443

# Local admin credentials (required)
# Note: Cloud/SSO accounts are not supported
UNIFI_USERNAME=admin
UNIFI_PASSWORD=your-password-here

# Site name (optional, defaults to "default")
UNIFI_SITE=default

# Set to "true" for UDM Pro, UDM SE, or UCG devices
# These require the /proxy/network API prefix
UNIFI_IS_UDM_PRO=true
